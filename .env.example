# API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knotree_cloud
BIND_ADDR=0.0.0.0:8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SESSION_TTL_DAYS=30
DATABASE_MAX_CONNECTIONS=10
DATABASE_PROVISIONING_ENABLED=true
DATABASE_RESOURCE_HOST=localhost
DATABASE_RESOURCE_PORT=5432
DATABASE_RESOURCE_PUBLIC_HOST=
DATABASE_RESOURCE_PUBLIC_PORT=
# Development provisions one PostgreSQL container and volume per project.
DATABASE_CLUSTER_PROVIDER=docker
DATABASE_CLUSTER_IMAGE=postgres:16-alpine
DATABASE_CLUSTER_DOCKER_BINARY=docker
DATABASE_CLUSTER_BIND_ADDRESS=127.0.0.1
DATABASE_CLUSTER_STARTUP_TIMEOUT_SECONDS=90
DATABASE_CLUSTER_STORAGE_SIZE=10Gi
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_QUERY_MAX_ROWS=500
# 32-byte base64url key; development has a deterministic fallback when omitted.
DATABASE_CREDENTIALS_ENCRYPTION_KEY=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA
RUST_LOG=info,knotree_api=debug

# Web (Vite build-time value)
VITE_API_BASE_URL=http://localhost:8080/api/v1
