# API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knotree_cloud
BIND_ADDR=0.0.0.0:8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SESSION_TTL_DAYS=30
DATABASE_MAX_CONNECTIONS=10
DATABASE_PROVISIONING_ENABLED=true
DATABASE_RESOURCE_HOST=127.0.0.1
DATABASE_RESOURCE_PORT=5432
DATABASE_RESOURCE_PUBLIC_HOST=
DATABASE_RESOURCE_PUBLIC_PORT=
# Development provisions one PostgreSQL container and volume per project.
DATABASE_CLUSTER_PROVIDER=docker
DATABASE_CLUSTER_IMAGE=postgres:16-alpine
DATABASE_CLUSTER_DOCKER_BINARY=docker
DATABASE_CLUSTER_BIND_ADDRESS=127.0.0.1
DATABASE_CLUSTER_STARTUP_TIMEOUT_SECONDS=90
DATABASE_CLUSTER_STORAGE_SIZE=10Gi
# Every project database and Docker App service exposes a product allocation of
# 1 virtual CPU, 1 GiB RAM, and 10 GiB storage. Kubernetes App services use a
# smaller host CPU quota so a 6-CPU node can run many mostly idle services.
# Kubernetes rejects a database storage value above 10Gi.
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_QUERY_MAX_ROWS=500
# 32-byte base64url key; development has a deterministic fallback when omitted.
DATABASE_CREDENTIALS_ENCRYPTION_KEY=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA
# App services run as Docker containers in development. The API publishes a
# loopback port and returns a URL using this host.
APP_SERVICE_PROVISIONING_ENABLED=true
APP_SERVICE_PUBLIC_HOST=localhost
# Public wildcard domain. Point *.knotree.org at the API ingress; each service
# receives a stable random subdomain. Set this to blank to keep localhost URLs.
APP_SERVICE_PUBLIC_DOMAIN=knotree.org
APP_SERVICE_PUBLIC_SCHEME=https
APP_SERVICE_BIND_ADDRESS=127.0.0.1
APP_SERVICE_DEFAULT_RATE_LIMIT_RPM=60
KONG_ADMIN_URL=
REDIS_CLUSTER_IMAGE=redis:7-alpine
APP_SERVICE_IMAGE_PULL_SECRET=
MCP_PUBLIC_BASE_URL=http://localhost:8080
MCP_ACCESS_TTL_SECONDS=3600
MCP_REFRESH_TTL_SECONDS=2592000
KNOTREE_DOCS_DIR=docs
# Optional GitHub OAuth App credentials. Public images work without these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
RUST_LOG=info,knotree_api=debug

# Web (Vite build-time value)
VITE_API_BASE_URL=http://localhost:8080/api/v1
