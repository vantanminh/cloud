{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knotree-cloud-web",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "cloud.knotree.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
